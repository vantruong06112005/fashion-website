# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN (SAMPLE)
# Sao chép file này thành .env tại thư mục gốc và điền thông tin thật của bạn
# ==========================================

# 1. Cloudinary (Lưu trữ và quản lý hình ảnh - Chi tiết xem docs/CLOUDINARY.md)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 2. Database (MariaDB / MySQL)
DB_URL=jdbc:mariadb://localhost:3306/fashion-website?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_database_password

# 3. JWT Security (Chi tiết xem docs/SECURITY.md)
# Khóa bí mật HMAC-SHA512 (tối thiểu 64 byte / 128 ký tự hex ngẫu nhiên)
JWT_SIGNER_KEY=your_super_secret_jwt_signer_key_min_64_bytes_128_hex_chars_here
JWT_ISSUER=fashion-website

# 4. CORS Origins (Phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 5. Cấu hình nạp/merge dữ liệu mẫu (InitData)
# - Để SEED_ENABLED=true ở lần chạy đầu (máy mới/DB trống) hoặc khi vừa pull InitData mới về cần merge.
# - Chạy xong đổi về SEED_ENABLED=false để các lần khởi động sau không chạy lại InitData.
SEED_ENABLED=true
SEED_DEFAULT_PASSWORD=123456

# 6. Mail Configuration (Gmail SMTP - Chi tiết xem docs/FORGOT_PASSWORD.md)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM_NAME=fashionwebsite

# 7. Google OAuth2 Login (Chi tiết xem docs/GOOGLE_LOGIN.md)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# =================================================================================
# 8. MODULE BIẾN MÔI TRƯỜNG SPRING AI EMBEDDING (TẦNG 3: AI UNDERSTANDING ENGINE)
# - Chức năng: Cung cấp khuôn mẫu khai báo khóa API và cấu hình cho mô hình Gemini Embedding.
# - Ý tưởng logic cốt lõi: Tách thông tin bảo mật (API Key) ra khỏi mã nguồn, nạp tự động vào Spring Boot.
# - Đầu vào (Parameters): Người phát triển điền khóa API lấy tại https://aistudio.google.com/app/apikey
# - Đầu ra (Return): Cung cấp 3 biến môi trường GEMINI_API_KEY, GEMINI_EMBEDDING_MODEL, GEMINI_EMBEDDING_DIMENSIONS.
# =================================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768

# 9. Giao hàng nhanh (GHN)
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_ghn_shop_id_here
