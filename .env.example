# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN (SAMPLE)
# Sao chép file này thành .env tại thư mục gốc và điền thông tin thật của bạn
# ==========================================

# 1. Cloudinary (Lưu trữ và quản lý hình ảnh - Chi tiết xem docs/CLOUDINARY.md)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 2. Database (MariaDB / MySQL)
DB_URL=jdbc:mariadb://localhost:3306/fashion-website
DB_USERNAME=root
DB_PASSWORD=your_database_password

# 3. JWT Security (Chi tiết xem docs/SECURITY.md)
# Khóa bí mật HMAC-SHA512 (tối thiểu 64 byte / 128 ký tự hex ngẫu nhiên)
JWT_SIGNER_KEY=your_super_secret_jwt_signer_key_min_64_bytes_128_hex_chars_here
JWT_ISSUER=fashion-website

# 4. CORS Origins (Phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 5. Mật khẩu mặc định khi seed tài khoản hệ thống ban đầu
SEED_DEFAULT_PASSWORD=123456
