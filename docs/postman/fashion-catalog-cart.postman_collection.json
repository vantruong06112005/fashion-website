    {
      "name": "Cart",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{customerToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get My Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cart"
          },
          "response": []
        },
        {
          "name": "Add Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const data = pm.response.json().data;",
                  "  const item = data?.items?.find(i => String(i.variantId) === pm.collectionVariables.get(\"variantId\"));",
                  "  if (item) pm.collectionVariables.set(\"cartItemId\", item.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variantId\": \"{{variantId}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/cart/items"
          },
          "response": []
        },
        {
          "name": "Update Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/cart/items/{{cartItemId}}"
          },
          "response": []
        },
        {
          "name": "Remove Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/cart/items/{{cartItemId}}"
          },
          "response": []
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/cart/items"
          },
          "response": []
        }
      ]
    }
